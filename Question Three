
age = int(input("Enter your age: "))

if age < 0:
    print("Invalid age.")
elif age <= 12:
    print("You are a child.")
elif age <= 19:
    print("You are a teenager.")
elif age <= 65:
    print("You are an adult.")
elif age <= 100:
    print("You are a senior.")
else:
    print("Congratulations! You appear on the Smucker's jar!")
