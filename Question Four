
from graphics import *

def clickedButton(point, button):
    if (point.getX() >= button.getP1().getX() and
        point.getX() <= button.getP2().getX() and
        point.getY() >= button.getP1().getY() and
        point.getY() <= button.getP2().getY()):
        return True
    else:
        return False

win = GraphWin("Button Click Program", 400, 300)

button = Rectangle(Point(100, 100), Point(300, 200))
button.setFill("lightblue")
button.draw(win)

label = Text(Point(200, 150), "CLICK HERE")
label.draw(win)

message = Text(Point(200, 250), "Click the button 10 times")
message.draw(win)

for i in range(10):
    point = win.getMouse()

    if clickedButton(point, button):
        message.setText("Button was clicked!")
    else:
        message.setText("Button was NOT clicked!")

win.close()
